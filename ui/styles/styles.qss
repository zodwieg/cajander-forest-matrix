/* ==========================================================================
   Фикс фонов для монолитного интерфейса плагина
   ========================================================================== */

/* 1. Выравниваем фон самого диалога и панелей вкладок */
QDialog, 
QTabWidget::panel {
    background-color: #fcfcfc; /* Подставь сюда свой точный колорпикнутый HEX */
}

/* 2. Лечим серый viewport у QScrollArea на обеих вкладках */
QScrollArea, 
QScrollArea > QWidget, 
QScrollArea #content_container {
    background-color: #fcfcfc; /* Должен строго совпадать с цветом выше */
    border: none;
}
